# VITE_* vars are inlined at BUILD time by Vite.
# Setting them in the Cloudflare dashboard under "Variables and Secrets"
# does NOT work — this deploys as a static asset Worker with no runtime JS.
# For CI/Cloudflare Workers Builds, set them as BUILD variables.

VITE_API_URL='http://localhost:8080'
VITE_RAG_API_URL='http://localhost:8000'
